# Editor temporary files
*~
*.swp
*.swo
.idea/
.vscode/*.log
.vscode/*.tmp

# Local secrets (keep safe example configuration tracked)
.env
.env.*
!.env.example
!.env.*.example
.envrc
.direnv/
.aws/
secrets.local.*

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node.js dependencies
node_modules/

# Keep the authoritative vanilla website in root dist/ tracked.
# React and other experimental builds are generated artifacts.
react-preview-dist/
experiments/**/dist/

# Python temporary files
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS temporary files
.DS_Store
._*
Thumbs.db
Desktop.ini

# Private local game artwork only; code, data and existing art remain tracked.
/dist/assets/games/darkest-dungeon-1/private/
